# Supabase (safe to expose: anon key is public, protected by RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Booking / scheduler embed for /call (Cal.com or Calendly)
VITE_SCHEDULER_URL=

# Payments. Phase 1 is manual wire, so no secrets are needed here.
# NEVER put a payment SECRET key in a VITE_ variable: it ships to the browser.
# When Stitch goes live, its secret belongs in a Supabase Edge Function, not here.
VITE_PAYMENT_PROVIDER=manual_wire
