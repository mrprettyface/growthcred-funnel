# Supabase (safe to expose: anon key is public, protected by RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Booking / scheduler embed for /call (Cal.com or Calendly)
VITE_SCHEDULER_URL=

# Payments. Phase 1 is manual wire, so no secrets are needed here.
# NEVER put a payment SECRET key in a VITE_ variable: it ships to the browser.
# When Stitch goes live, its secret belongs in a Supabase Edge Function, not here.
VITE_PAYMENT_PROVIDER=manual_wire

# These are Supabase Edge Function secrets, not VITE_ variables. Set them in
# Supabase's Edge Function Secrets dashboard; do not add real values here.
# WHOP_COMPANY_ID=biz_6zU0cw4ZzQ1SpU
# WHOP_WEBHOOK_SECRET=ws_...
# RESEND_API_KEY=re_...
# PURCHASE_EMAIL_FROM=GrowthCred <info@growthcred.co.za>
# SUPABASE_SERVICE_ROLE_KEY=server-only-secret
# CONTACT_NOTIFY_EMAIL=info@growthcred.co.za   (optional, contact alerts)
# SITE_URL=https://growthcred.co.za            (optional, contact email copy)

# Optional GA4. Leave blank until your own property exists. Analytics is opt-in.
VITE_GA4_MEASUREMENT_ID=
